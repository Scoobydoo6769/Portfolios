# matplotlib dictionary

# x = [Follow by range in X Line]
# y = [Follow by range in Y Line]
# plt.plot(x ,y) = creating the graph variables
# plt.show() = show the graph

# plot customization
# marker=".", select the marker of each edge
# markersize=30, adjusting the size of a marker
# markerfacecolor="Follow by hex code color", select marker color
# markeredgecolor="Follow by hex code color", select marker edge color
# linestyle = "solid, dotted, dashed and more", select line style
# linewidth= value, select the thickness of the line
# color="Follow by hex color", select line color
# line_style = dict(marker".', markersize=30, etc.), create a style dictionary to use it fo every line at once
# plt.plot(x, y1, **line_style), call the style function

# Labels
# plt.title("Title of the graph")
# plt.xlabel("X label") assigning X line name
# plt.ylabel("Y label") assigning Y line name
# plt.tick_params(axis="both",color="Hex color code") customizing the parameter
# plt.xticks(x or y) show only the assigned number in the array group variables
# fontsize= 25 enter the font size
# family="Arial" choosing text style
# fontweight="bold" adjusting how thick the font is
# color="Hex color code" setting text color 

# grids() = Helps make plots easier to read by adding reference lines.
# plt.grid() create a grid on the graph
# axis="y or x" assigning which axis to apply grid
# linewidth=2 apply the thickness of the grid line
# color="Follow by color name or code hex" change the grid color
# linestyle="dashed" Change the line style

# Bar chart = compare categories of data by representing each category with a bar
# plt.bar() calling bar chart function
# plt.barh() make it horizontal

