{
  // ────────────────────────────────────────────────────────────
  //  LUMINA STORE — VS Code Workspace Configuration
  //  Open the shop/ folder in VS Code for best experience.
  // ────────────────────────────────────────────────────────────

  // ── EDITOR VISUALS ──────────────────────────────────────────
  "editor.fontFamily": "'Fira Code', 'JetBrains Mono', 'Cascadia Code', Menlo, monospace",
  "editor.fontSize": 14,
  "editor.lineHeight": 1.7,
  "editor.fontLigatures": true,
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "editor.renderWhitespace": "boundary",
  "editor.minimap.enabled": true,
  "editor.minimap.renderCharacters": false,
  "editor.stickyScroll.enabled": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",

  // ── THEME & ICONS ────────────────────────────────────────────
  "workbench.colorTheme": "One Dark Pro Monokai Darker",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.productIconTheme": "fluent-icons",

  // ── FORMATTING ───────────────────────────────────────────────
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,

  // ── PRETTIER CONFIG ──────────────────────────────────────────
  "prettier.singleQuote": true,
  "prettier.semi": true,
  "prettier.trailingComma": "es5",
  "prettier.printWidth": 100,
  "prettier.tabWidth": 2,
  "prettier.arrowParens": "avoid",

  // ── EMMET ────────────────────────────────────────────────────
  "emmet.includeLanguages": {
    "html": "html",
    "javascript": "html"
  },
  "emmet.triggerExpansionOnTab": true,
  "emmet.showExpandedAbbreviation": "always",

  // ── INTELLISENSE & AUTOCOMPLETE ──────────────────────────────
  "editor.quickSuggestions": {
    "strings": true,
    "other": true,
    "comments": false
  },
  "editor.suggestSelection": "first",
  "editor.parameterHints.enabled": true,
  "editor.hover.delay": 300,
  "css.validate": true,
  "css.lint.unknownAtRules": "ignore",
  "html.autoClosingTags": true,
  "html.suggest.html5": true,

  // ── LIVE SERVER ──────────────────────────────────────────────
  "liveServer.settings.donotShowInfoMsg": true,
  "liveServer.settings.port": 5500,
  "liveServer.settings.CustomBrowser": "chrome",
  "liveServer.settings.root": "/",
  "liveServer.settings.NoBrowser": false,

  // ── TERMINAL ─────────────────────────────────────────────────
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.lineHeight": 1.3,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.defaultProfile.osx": "zsh",

  // ── GIT ──────────────────────────────────────────────────────
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,

  // ── FILE ASSOCIATIONS ────────────────────────────────────────
  "files.associations": {
    "*.css": "css",
    "*.html": "html",
    "*.js": "javascript"
  },

  // ── EXPLORER ─────────────────────────────────────────────────
  "explorer.compactFolders": false,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "index.html": "style.css, script.js"
  },

  // ── COLOR CUSTOMIZATIONS (matches Lumina palette) ─────────────
  "workbench.colorCustomizations": {
    "activityBar.background": "#080808",
    "sideBar.background": "#0a0a0a",
    "editor.background": "#0d0d0d",
    "statusBar.background": "#111111",
    "statusBar.foreground": "#a855f7",
    "editorLineNumber.activeForeground": "#a855f7",
    "editorCursor.foreground": "#a855f7",
    "editor.selectionBackground": "#a855f726",
    "editor.wordHighlightBackground": "#6366f118",
    "tab.activeBorderTop": "#a855f7",
    "focusBorder": "#a855f7"
  },

  // ── RECOMMENDED EXTENSIONS (install these!) ──────────────────
  // • esbenp.prettier-vscode        — Prettier formatter
  // • ritwickdey.LiveServer          — Live preview in browser
  // • dbaeumer.vscode-eslint         — JS linting
  // • ecmel.vscode-html-css          — HTML/CSS Intellisense
  // • zignd.html-css-class-completion — Class name completion
  // • PKief.material-icon-theme      — File icons
  // • zhuangtongfa.material-theme    — One Dark Pro theme
  // • formulahendry.auto-rename-tag  — Rename paired HTML tags
  // • christian-kohler.path-intellisense — Path autocomplete
  // • naumovs.color-highlight        — Color preview in editor

  "extensions.ignoreRecommendations": false
}
